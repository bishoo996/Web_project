<div id="contactModal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.7); z-index:9999; align-items:center; justify-content:center;">
    <div style="background:var(--card-bg, #1a1a2e); border:1px solid rgba(124,58,237,0.3); border-radius:14px; padding:32px; width:100%; max-width:420px; margin:16px; position:relative;">
        <button onclick="closeContactModal()" style="position:absolute; top:14px; right:16px; background:none; border:none; color:inherit; font-size:20px; cursor:pointer; opacity:0.6;">✕</button>
        <h3 style="margin:0 0 6px; font-size:20px;">Contact Us</h3>
        <p style="margin:0 0 20px; font-size:13px; opacity:0.6;">We'll get back to you as soon as possible.</p>
        <div style="display:flex; flex-direction:column; gap:12px;">
            <input id="contactModalName" type="text" placeholder="Your name" style="padding:10px 12px; border-radius:8px; border:1px solid rgba(255,255,255,0.15); background:rgba(255,255,255,0.07); color:inherit; font-size:14px;">
            <input id="contactModalEmail" type="email" placeholder="Your email" style="padding:10px 12px; border-radius:8px; border:1px solid rgba(255,255,255,0.15); background:rgba(255,255,255,0.07); color:inherit; font-size:14px;">
            <textarea id="contactModalMessage" placeholder="Your message" rows="4" style="padding:10px 12px; border-radius:8px; border:1px solid rgba(255,255,255,0.15); background:rgba(255,255,255,0.07); color:inherit; font-size:14px; resize:none;"></textarea>
            <button onclick="sendContactEmail()" style="padding:11px; background:#7C3AED; color:white; border:none; border-radius:8px; cursor:pointer; font-weight:700; font-size:14px;">Send Message</button>
            <p id="contactModalResult" style="font-size:13px; margin:0; text-align:center;"></p>
        </div>
    </div>
</div>
<script>
    function openContactModal() { document.getElementById('contactModal').style.display = 'flex'; }
    function closeContactModal() { document.getElementById('contactModal').style.display = 'none'; document.getElementById('contactModalResult').textContent = ''; }
    document.getElementById('contactModal').addEventListener('click', function(e) { if (e.target === this) closeContactModal(); });
    async function sendContactEmail() {
        const name = document.getElementById('contactModalName').value.trim();
        const email = document.getElementById('contactModalEmail').value.trim();
        const message = document.getElementById('contactModalMessage').value.trim();
        const resultEl = document.getElementById('contactModalResult');
        if (!name || !email || !message) { resultEl.style.color = '#f87171'; resultEl.textContent = 'Please fill in all fields.'; return; }
        resultEl.style.color = '#aaa'; resultEl.textContent = 'Sending...';
        try {
            const res = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ name, email, message }) });
            const data = await res.json();
            if (data.success) { resultEl.style.color = '#4ade80'; resultEl.textContent = '✅ Message sent!'; document.getElementById('contactModalName').value = ''; document.getElementById('contactModalEmail').value = ''; document.getElementById('contactModalMessage').value = ''; }
            else { resultEl.style.color = '#f87171'; resultEl.textContent = '❌ ' + data.error; }
        } catch { resultEl.style.color = '#f87171'; resultEl.textContent = '❌ Failed to send. Try again.'; }
    }
</script>
