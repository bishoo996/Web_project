<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Overclocked - GPU & CPU Benchmark</title>
    <link rel="stylesheet" href="./assets/css/style.css">
</head>
<body>

<%- include('partials/header') %>

    <section id="hero">
        <div class="hero-content">
            <h1>Component Benchmark</h1>
            <p>Select a GPU or CPU to see its performance scores</p>

            <div class="selection-controls">
                <div class="selector-group">
                    <label for="gpu-select">Graphics Card (GPU)</label>
                    <select id="gpu-select">
                        <option value="">-- Select GPU --</option>
                        <option value="rtx4090">NVIDIA RTX 4090</option>
                        <option value="rtx4080">NVIDIA RTX 4080</option>
                        <option value="rx7900xtx">AMD RX 7900 XTX</option>
                        <option value="rtx4070">NVIDIA RTX 4070</option>
                    </select>
                </div>

                <div class="selector-group">
                    <label for="cpu-select">Processor (CPU)</label>
                    <select id="cpu-select">
                        <option value="">-- Select CPU --</option>
                        <option value="i9-13900k">Intel i9-13900K</option>
                        <option value="i7-13700k">Intel i7-13700K</option>
                        <option value="ryzen9-7950x">AMD Ryzen 9 7950X</option>
                        <option value="ryzen7-7700x">AMD Ryzen 7 7700X</option>
                    </select>
                </div>
            </div>

            <button id="run-benchmark-btn" class="btn-primary">Run Benchmark</button>
        </div>
    </section>

    <section id="benchmark-results">
        <h2>Benchmark Results</h2>

        <div class="benchmark-row">
            <label>Performance</label>
            <div class="bar-container">
                <div id="performance-bar" class="bar-fill"></div>
                <span class="score-text" id="performance-score">0/100</span>
            </div>
        </div>

        <div class="benchmark-row">
            <label>Memory</label>
            <div class="bar-container">
                <div id="memory-bar" class="bar-fill"></div>
                <span class="score-text" id="memory-score">0/100</span>
            </div>
        </div>

        <div class="benchmark-row">
            <label>Power Efficiency</label>
            <div class="bar-container">
                <div id="power-bar" class="bar-fill"></div>
                <span class="score-text" id="power-score">0/100</span>
            </div>
        </div>

        <div class="benchmark-row">
            <label>Thermal Performance</label>
            <div class="bar-container">
                <div id="thermal-bar" class="bar-fill"></div>
                <span class="score-text" id="thermal-score">0/100</span>
            </div>
        </div>
    </section>

    <section id="game-simulation">
        <h2>Simulate FPS by Game</h2>
        <p class="subtitle">Click on a game to see estimated FPS with your selected components</p>

        <div id="dynamic-game-grid" style="display: flex; flex-wrap: wrap; gap: 20px;">
        </div>
    </section>

    <section id="fps-results">
        <h2>Estimated FPS</h2>
        <div class="fps-display">
            <div class="fps-value" id="fps-number">--</div>
            <div class="fps-label">Frames Per Second</div>
            <div class="game-title" id="selected-game">Select a game above</div>
            <div class="quality-settings">
                <span>Settings: </span>
                <span id="quality-preset">Ultra - 1080p</span>
            </div>
        </div>
    </section>

<%- include('partials/footer') %>

    <script src="./assets/js/nav-auth.js"></script>
    <script src="./assets/js/cart-widget.js"></script>
    <script src="./assets/js/benchmark-script.js"></script>

<%- include('partials/contact-modal') %>
</body>
</html>
