<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Overclocked — Shopping Cart</title>
    <link rel="stylesheet" href="./assets/css/style.css">
    <link rel="stylesheet" href="./assets/css/cart.css">
</head>
<body>

<%- include('partials/header') %>

<!-- ═══════════════════════ PAGE ═══════════════════════ -->
<div class="cart-page" id="cartPageRoot">

    <!-- Auth banner (shown when not logged in) -->
    <div class="cart-auth-banner" id="cartAuthBanner" style="display:none;">
        <p><span class="material-icons icon-inline" aria-hidden="true">lock</span> <strong>Sign in</strong> to save your cart across devices and complete checkout.</p>
        <a href="./sign_in.html" class="btn-primary" style="white-space:nowrap; text-decoration:none;">Sign In</a>
    </div>

    <!-- Title row -->
    <div class="cart-page-title" id="cartTitle">
        <span class="material-icons icon-inline" aria-hidden="true">shopping_cart</span> Shopping Cart <span class="cart-count-badge" id="cartCountBadge">0</span>
    </div>

    <!-- Items column -->
    <div class="cart-items-col" id="cartItemsCol">
        <!-- Populated by JS -->
    </div>

    <!-- Summary column -->
    <div class="cart-summary-col" id="cartSummaryCol" style="display:none;">
        <div class="cart-summary-card">
            <div class="cart-summary-title">Order Summary</div>

            <div class="summary-line">
                <span class="label">Items (<span id="summaryItemCount">0</span>)</span>
                <span class="value" id="summarySubtotal">$0.00</span>
            </div>
            <div class="summary-line">
                <span class="label">Shipping</span>
                <span class="value" id="summaryShipping">Free</span>
            </div>
            <div class="summary-line">
                <span class="label">Tax (est.)</span>
                <span class="value" id="summaryTax">$0.00</span>
            </div>

            <div class="summary-divider"></div>

            <div class="summary-total-line">
                <span class="label">Total</span>
                <span class="value" id="summaryTotal">$0.00</span>
            </div>

            <button class="btn-checkout" id="checkoutBtn">
                <span class="material-icons icon-inline" aria-hidden="true">lock</span> Proceed to Checkout
            </button>

            <div class="secure-badge"><span class="material-icons icon-inline" aria-hidden="true">lock</span> Secure checkout — SSL encrypted</div>
        </div>
    </div>
</div>

<!-- ═══════════════════════ CHECKOUT MODAL ═══════════════════════ -->
<div class="checkout-modal-overlay" id="checkoutModal">
    <div class="checkout-modal">
        <h3>Complete Your Order</h3>
        <p>Fill in your details to place the order.</p>

        <div class="checkout-form-group">
            <label>Shipping Address</label>
            <input type="text" class="checkout-input" id="checkoutAddress" placeholder="123 Main St, City, Country">
        </div>

        <div class="checkout-form-group">
            <label>Payment Method</label>
            <select class="checkout-input" id="checkoutPayment">
                <option value="card">Credit / Debit Card</option>
                <option value="paypal">PayPal</option>
                <option value="bank">Bank Transfer</option>
                <option value="cash">Cash on Delivery</option>
            </select>
        </div>

        <div class="checkout-form-group">
            <label>Order Notes (optional)</label>
            <input type="text" class="checkout-input" id="checkoutNotes" placeholder="Any special instructions?">
        </div>

        <div class="checkout-btn-row">
            <button class="btn-checkout-cancel" id="checkoutModalCancel">Cancel</button>
            <button class="btn-checkout-confirm" id="checkoutModalConfirm">Place Order</button>
        </div>
    </div>
</div>

<!-- ═══════════════════════ BUILD WARNING POPUP ═══════════════════════ -->
<div class="checkout-modal-overlay build-warning-overlay" id="buildWarningOverlay">
    <div class="checkout-modal">
        <h3>Build Incomplete</h3>
        <p>Your cart appears to be part of a PC build but is missing essential components needed to boot.</p>

        <div class="warning-parts-list">
            <strong>Missing parts:</strong>
            <ul id="buildWarningList"></ul>
        </div>

        <div class="checkout-btn-row">
            <button class="btn-checkout-cancel" id="buildWarningCancel">Cancel</button>
            <button class="btn-checkout-confirm" id="buildWarningConfirm">Continue anyway</button>
        </div>
    </div>
</div>

<!-- ═══════════════════════ SUCCESS OVERLAY ═══════════════════════ -->
<div class="order-success-overlay" id="orderSuccessOverlay">
    <div class="order-success-box">
        <div class="success-checkmark">✅</div>
        <h3>Order Placed!</h3>
        <p>Your order has been confirmed and is being processed. You can track it in <strong>My Account → Orders</strong>.</p>
        <div style="display:flex; gap:12px; justify-content:center; flex-wrap:wrap;">
            <a href="./account.html" class="btn-account-primary" style="display:inline-block; text-decoration:none; padding:11px 24px; background:var(--primary-color); color:white; border-radius:8px; font-weight:700;">View My Orders</a>
            <a href="./category.html" style="display:inline-block; padding:11px 24px; border:1px solid rgba(124,58,237,0.3); color:var(--text-muted); border-radius:8px; font-weight:600; text-decoration:none;">Continue Shopping</a>
        </div>
    </div>
</div>

<!-- ═══════════════════════ TOAST ═══════════════════════ -->
<div class="cart-toast" id="cartToast"></div>

<%- include('partials/footer') %>

<script src="./assets/js/nav-auth.js"></script>
<script src="./assets/js/cart.js"></script>

<%- include('partials/contact-modal') %>
</body>
</html>
