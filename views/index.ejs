<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Overclocked - PC Parts Marketplace</title>
    <link rel="stylesheet" href="./assets/css/style.css">
</head>
<body>

<%- include('partials/header') %>

    <!-- Banner Section -->
    <section class="banner" id="home">
        <div class="banner-glow"></div>
        <div class="banner-content">
            <p class="banner-tag">New Season 2026</p>
            <h1 class="banner-title">Build Your <span class="highlight">Dream PC</span></h1>
            <p class="banner-subtitle">
                Find the perfect parts with smart tools like the bottleneck
                calculator, FPS estimator, and expert-curated products from top brands.
            </p>
            <div class="banner-buttons">
                <button class="btn-primary btn-large" onclick="window.location.href='./category.html'">Shop Now</button>
                <button class="btn-outline btn-large" onclick="window.location.href='./builder_index.html'">Build a PC</button>
            </div>
            <div class="banner-stats">
                <div class="stat">
                    <h3>500+</h3>
                    <p>Products</p>
                </div>
                <div class="stat">
                    <h3>50+</h3>
                    <p>Brands</p>
                </div>
                <div class="stat">
                    <h3>24/7</h3>
                    <p>Support</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Features Strip -->
    <section class="features-strip">
        <div class="features-container">
            <div class="feature">
                <span class="feature-icon">🚚</span>
                <div class="feature-text">
                    <h4>Free Shipping</h4>
                    <p>On orders over $500</p>
                </div>
            </div>
            <div class="feature">
                <span class="feature-icon">🛡️</span>
                <div class="feature-text">
                    <h4>2-Year Warranty</h4>
                    <p>On all products</p>
                </div>
            </div>
            <div class="feature">
                <span class="feature-icon">💬</span>
                <div class="feature-text">
                    <h4>24/7 Support</h4>
                    <p>Expert help anytime</p>
                </div>
            </div>
            <div class="feature">
                <span class="feature-icon">🔒</span>
                <div class="feature-text">
                    <h4>Secure Payment</h4>
                    <p>SSL protected checkout</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Products Section -->
    <section class="offers" id="offers">
        <div class="section-header">
            <h2>Featured Products</h2>
            <p>Handpicked processors from our top vendors</p>
        </div>

        <!-- Product cards are generated by JavaScript -->
        <div class="offers-grid" id="offersGrid"></div>
    </section>

    <!-- Categories Section -->
    <section class="categories" id="categories">
        <div class="section-header">
            <h2>Shop by Category</h2>
            <p>Find exactly what you need, faster</p>
        </div>
    <div class="categories-grid">
    <a href="./category.html?category=cpu" class="category-card">
        <div class="category-icon"><span class="material-icons">settings</span></div>
        <h3>Processors</h3>
        <p>45+ products</p>
    </a>
    <a href="./category.html?category=gpu" class="category-card">
        <div class="category-icon"><span class="material-icons">sports_esports</span></div>
        <h3>Graphics Cards</h3>
        <p>60+ products</p>
    </a>
    <a href="./category.html?category=memory" class="category-card">
        <div class="category-icon"><span class="material-icons">memory</span></div>
        <h3>Memory</h3>
        <p>80+ products</p>
    </a>
    <a href="./category.html?category=storage" class="category-card">
        <div class="category-icon"><span class="material-icons">storage</span></div>
        <h3>Storage</h3>
        <p>90+ products</p>
    </a>
    <a href="./category.html?category=psu" class="category-card">
        <div class="category-icon"><span class="material-icons">bolt</span></div>
        <h3>Power Supplies</h3>
        <p>50+ products</p>
    </a>
    <a href="./category.html?category=motherboard" class="category-card">
        <div class="category-icon"><span class="material-icons">developer_board</span></div>
        <h3>Motherboards</h3>
        <p>40+ products</p>
    </a>
    <a href="./category.html?category=cooler" class="category-card">
        <div class="category-icon"><span class="material-icons">ac_unit</span></div>
        <h3>Coolers</h3>
        <p>60+ products</p>
    </a>
    <a href="./category.html?category=case" class="category-card">
        <div class="category-icon"><span class="material-icons">computer</span></div>
        <h3>PC Cases</h3>
        <p>35+ products</p>
    </a>
</div>


        </div>
    </section>

<%- include('partials/footer') %>

    <!-- Product Detail Modal -->
    <div class="modal-overlay" id="productModal">
        <div class="modal-content">
            <button class="modal-close" id="modalClose">×</button>
            <div class="modal-body">
                <div class="modal-image">
                    <img src="" alt="" id="modalImage" onerror="this.style.display='none'">
                    <span class="image-fallback" id="modalFallback">💻</span>
                </div>
                <div class="modal-details">
                    <span class="modal-badge" id="modalBadge"></span>
                    <h2 id="modalName"></h2>
                    <div class="modal-rating" id="modalRating"></div>
                    <p class="modal-description" id="modalDescription"></p>
                    <div class="modal-specs-title">Full Specifications</div>
                    <ul class="modal-specs-list" id="modalSpecsList"></ul>
                    <div class="modal-price">
                        <span class="old-price" id="modalOldPrice"></span>
                        <span class="new-price" id="modalNewPrice"></span>
                    </div>
                    <button class="btn-primary btn-large" id="modalAddToCart">Add to Cart</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Toast notification -->
    <div class="toast" id="toast">
        <span class="toast-icon">✓</span>
        <span class="toast-message">Added to cart!</span>
    </div>

    <script src="./assets/js/nav-auth.js"></script>
    <script src="./assets/js/cart-widget.js"></script>
    <script src="./assets/js/script.js"></script>

<%- include('partials/contact-modal') %>
</body>
</html>
